# The Pit: settings. Copy this file to .env and fill in the keys you have.
# Every key is optional: leave one empty and that part runs on a built-in mock.
# .env is git-ignored. Never commit real keys. Keys stay on the server; the
# browser never sees them.

# --- Claude (Anthropic API) -------------------------------------------------
# Empty = "Mock Claude": realistic fake streaming, no cost.
ANTHROPIC_API_KEY=
# Models, one per role. Sonnet-class for trade rounds and floor debates; Haiku-class for
# "Claude writes the news", ask-a-trader and the narrator. Leave a role empty to use the default.
AI_MODEL_ROUND=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_DEBATE=
AI_MODEL_NEWS=
AI_MODEL_ASK=
AI_MODEL_NARRATOR=
# Abort a model call that takes longer than this and finish on offline rules.
AI_ROUND_TIMEOUT_MS=40000
# Optional price table for cost estimates (US$ per million tokens: [input, output]).
# AI_PRICES={"claude-sonnet-5-5":[2,10],"claude-haiku-5-5":[0.1,0.5]}
# How hard the trade-round model thinks (low|medium|high). "Deep think" uses AI_EFFORT_DEEP.
AI_EFFORT_ROUND=low
AI_EFFORT_DEEP=high
# auto = real Claude when a key is set, else mock. Also: anthropic | mock | off (offline rules only).
AI_PROVIDER=auto

# --- Cost guard ----------------------------------------------------------------
# AI trade rounds allowed per room per minute (a floor debate counts as 2). Extras run on offline rules.
AI_ROUNDS_PER_MIN_PER_ROOM=3
# AI rounds per room per day, and per room creator (IP) per day across all their rooms.
AI_ROOM_DAILY_ROUND_CAP=80
AI_OWNER_DAILY_ROUND_CAP=120
# Haiku calls (ask, wrap, headlines, narrator) per room per day.
AI_ROOM_DAILY_SMALL_CAP=80
# Seconds between headlines from the same player (news, floor check, "Claude writes the news").
NEWS_COOLDOWN_SEC=8
# Global caps per UTC day across all rooms. When hit, the game keeps working offline.
AI_DAILY_ROUND_CAP=200
AI_DAILY_SMALL_CAP=400

# --- Market data (Finnhub) ---------------------------------------------------------
# Empty = mock prices and made-up headlines. See docs/DATA.md.
FINNHUB_API_KEY=
QUOTE_POLL_SEC=15
NEWS_POLL_SEC=180
MARKET_PROVIDER=auto
# With the mock provider: a made-up headline every N seconds per ticker.
MOCK_NEWS_EVERY_SEC=240

# --- Database (Supabase) -----------------------------------------------------------
# Empty = keep everything in memory (lost when the server restarts).
# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# The SECRET key (sb_secret_...) or the legacy service_role key. Server only.
SUPABASE_SECRET_KEY=

# --- Server ------------------------------------------------------------------------
PORT=8787
MAX_ROOMS=50
MAX_PLAYERS_PER_ROOM=12
# Different Real-market tickers allowed at once (Finnhub's free plan: ~11 fit in 60 calls/min).
MAX_TICKERS=10
# Abuse limits.
MAX_SOCKETS_PER_IP=24
ROOM_CREATES_PER_IP_PER_MIN=6
# Extra origins allowed to open the WebSocket (comma-separated). Same-origin always works.
ALLOWED_ORIGINS=
# Trust X-Forwarded-For for client IPs. Only behind a real proxy. Auto-on when running on Render.
TRUST_PROXY=

# --- Admin / observability ---------------------------------------------------------------
# Open /admin#token=<this> to see rooms, AI latency, tokens, cost, data freshness and errors.
# Empty = the admin page only works from this computer (localhost).
ADMIN_TOKEN=
