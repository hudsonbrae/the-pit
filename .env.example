# The Pit: settings. Copy this file to .env and fill in the keys you have.
# Every key is optional: leave one empty and that part runs on a built-in mock.
# .env is git-ignored. Never commit real keys. Keys stay on the server; the
# browser never sees them.

# --- Claude (Anthropic API) -------------------------------------------------
# Empty = "Mock Claude": realistic fake streaming, no cost.
ANTHROPIC_API_KEY=
# Models: Sonnet-class for trade rounds, Haiku-class for headlines, wrap and ask-a-trader.
AI_MODEL_ROUND=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
# How hard the trade-round model thinks (low|medium|high). "Deep think" uses AI_EFFORT_DEEP.
AI_EFFORT_ROUND=low
AI_EFFORT_DEEP=high
# auto = real Claude when a key is set, else mock. Also: anthropic | mock | off (offline rules only).
AI_PROVIDER=auto

# --- Cost guard ----------------------------------------------------------------
# AI trade rounds allowed per room per minute. Extra rounds run on offline rules.
AI_ROUNDS_PER_MIN_PER_ROOM=3
# Global caps per UTC day across all rooms. When hit, the game keeps working offline.
AI_DAILY_ROUND_CAP=200
AI_DAILY_SMALL_CAP=400

# --- Market data (Finnhub) ---------------------------------------------------------
# Empty = mock prices and made-up headlines. See docs/DATA.md.
FINNHUB_API_KEY=
QUOTE_POLL_SEC=15
NEWS_POLL_SEC=180
MARKET_PROVIDER=auto
# With the mock provider: a made-up headline every N seconds per ticker.
MOCK_NEWS_EVERY_SEC=240

# --- Database (Supabase) -----------------------------------------------------------
# Empty = keep everything in memory (lost when the server restarts).
# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# The SECRET key (sb_secret_...) or the legacy service_role key. Server only.
SUPABASE_SECRET_KEY=

# --- Server ------------------------------------------------------------------------
PORT=8787
MAX_ROOMS=50
MAX_PLAYERS_PER_ROOM=12
